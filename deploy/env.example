# GOON.VC production environment — copy to /opt/goon.vc/.env (chmod 600).
# NEVER commit the real file.

# Upstream Fabric Hub for the proxied Hub APIs and Market escrow mailboxes.
FABRIC_HUB_ORIGIN=https://hub.fabric.pub
# More Hubs, tried in order when the ones before can't be reached.
FABRIC_HUB_SEEDS=https://hub.goon.vc

# Caddy terminates TLS and proxies to this port; bind loopback only.
FABRIC_HUB_PORT=8080
FABRIC_HUB_INTERFACE=127.0.0.1
FABRIC_HUB_HOSTNAME=goon.vc

NODE_ENV=production

# Discord bot token (Bot tab of the application). Without it there is no
# gateway: no /operations metrics, no IdleRPG presence, and no #idlerpg posts.
# The bot needs View Channel + Send Messages in G00N SQUAD #idlerpg
# (settings/local.js presence.announcements).
DISCORD_BOT_TOKEN=

# OAuth client secret of the same application. Without it Discord sign-in
# (and the waiting area) is off. Add
# https://goon.vc/services/members/discord/callback under OAuth2 → Redirects.
DISCORD_APP_SECRET=

# Passport sign-in is issued only for these origins.
GOON_MEMBERS_ORIGINS=https://goon.vc

# Bearer for the DM script, campaign, and hangar roster APIs (openssl rand -hex 32).
GOON_SCRIPTS_TOKEN=
# Unlocks edits to finished tournaments; empty keeps them final.
GOON_TOURNAMENTS_PASSWORD=
# Account keys (discord:<id>, comma separated) who decide escrow disputes.
GOON_MARKET_ARBITERS=
# 1 = DM campaigns, check-ins, welcome DMs (needs the Server Members intent).
GOON_CAMPAIGNS=

# goon.vc's Fabric key (relay, alliance, Market arbiter keys). Empty = one is
# generated once in stores/fabric; back that directory up.
GOON_FABRIC_XPRV=
