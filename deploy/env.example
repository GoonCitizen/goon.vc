# GOON.VC production environment — copy to /opt/goon.vc/.env (chmod 600).
# NEVER commit the real file.

# Upstream Fabric Hub that owns /sessions (Passport / GoonCitizen login).
FABRIC_HUB_ORIGIN=https://hub.fabric.pub
# More Hubs, tried in order when the ones before can't be reached.
FABRIC_HUB_SEEDS=https://hub.goon.vc

# Caddy terminates TLS and proxies to this port; bind loopback only.
FABRIC_HUB_PORT=8080
FABRIC_HUB_INTERFACE=127.0.0.1
FABRIC_HUB_HOSTNAME=goon.vc

NODE_ENV=production

# Discord bot token (Bot tab of the application). Without it there is no
# gateway: no /operations metrics, no IdleRPG presence, and no #idlerpg posts.
# The bot needs View Channel + Send Messages in G00N SQUAD #idlerpg
# (settings/local.js presence.announcements).
DISCORD_BOT_TOKEN=
